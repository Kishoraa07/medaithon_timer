# ==============================================================================
# MEDAITHON 2026 - ENVIRONMENT CONFIGURATION FOR VERCEL
# Add these variables under your Vercel Project Settings -> Environment Variables
# ==============================================================================

# --- 1. MONGODB DATABASE (For Persistent Multi-Device Timer & Event Photos) ---
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/medaithon2026?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=medaithon2026

# --- 2. CLOUDINARY CREDENTIALS (For Instant Live Photo CDN Hosting) ---
# Obtain from your Cloudinary Dashboard (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- 3. (OPTIONAL) FIXED EVENT SCHEDULE TIMESTAMPS ---
# If you want the 50-hour timer locked to an exact calendar start or deadline across all devices:
# MEDAITHON_START_TIME=2026-10-26T09:00:00+05:30
# MEDAITHON_TARGET_END_TIME=2026-10-28T11:00:00+05:30
